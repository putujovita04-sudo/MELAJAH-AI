{
  "name": "melajah-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MELAJAH AI — game ular tangga edukasi budaya Bali dengan juri AI",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
