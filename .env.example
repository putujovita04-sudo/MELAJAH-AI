# ============================================================
# MELAJAH AI — konfigurasi server
# Salin file ini menjadi .env di root proyek: cp .env.example .env
# JANGAN pernah menaruh API key di folder client atau di frontend.
# ============================================================

# Port server Express
PORT=4100

# Alamat frontend saat development (untuk CORS)
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# AI JURI (opsional)
# Kosongkan AI_API_KEY untuk memakai mode fallback pencocokan kata.
# Aplikasi tetap 100% bisa dimainkan tanpa API key.
# ------------------------------------------------------------
AI_API_KEY=
# Endpoint gaya OpenAI. Contoh:
#   OpenAI   : https://api.openai.com/v1
#   DeepSeek : https://api.deepseek.com/v1
#   Groq     : https://api.groq.com/openai/v1
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

# ------------------------------------------------------------
# Batas upload materi (byte) dan masa simpan soal materi (ms)
# ------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MATERIAL_TTL_MS=7200000

# Set "production" untuk menyajikan hasil build frontend dari Express
NODE_ENV=development

# ------------------------------------------------------------
# Sesi permainan multi-perangkat
# ------------------------------------------------------------
SESSION_TTL_MS=21600000
VERDICT_AUTO_MS=10000

# ------------------------------------------------------------
# Shared store untuk deployment serverless (Vercel) / multi-instance.
# Buat database Upstash Redis (gratis) lalu isi dua nilai di bawah.
# Tanpa ini, sesi hanya hidup di memori satu proses.
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
